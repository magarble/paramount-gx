{
  "manifest_version": 3,
  "name": "Paramount+ for Opera GX",
  "version": "1.0.0",
  "description": "Presents Opera GX as Chrome on Paramount+ to address unsupported-browser checks.",
  "minimum_chrome_version": "111",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.paramountplus.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*.paramountplus.com/*"],
    "js": ["identity.js", "content.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }]
}
